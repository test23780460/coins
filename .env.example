# Frontend (Vite) — public API base URL only. Never put secrets here.
VITE_API_BASE_URL=https://skyblock-coin-tracker.ptravis022.workers.dev

# Local development example:
# VITE_API_BASE_URL=http://127.0.0.1:8787

# ---------------------------------------------------------------------------
# Cloudflare Worker secrets (set with: npx wrangler secret put NAME)
# DO NOT put real values in this file or commit them.
# ---------------------------------------------------------------------------
# AUTH_PASSWORD_HASH   PBKDF2 hash from: npm run hash-password -- "your-password"
# SESSION_SECRET       Long random string for signing session tokens
# GITHUB_TOKEN         Fine-grained PAT with Contents: Read/Write on skyblock-coin-data
# HYPIXEL_API_KEY      Optional legacy fallback — prefer updating via the homepage API Connection card
# CONFIG_ENCRYPTION_KEY  AES key (base64 32 bytes) for encrypting API keys in PRIVATE_CONFIG KV
# SKYCRYPT_API_TOKEN   Optional — only if you have SkyCrypt backend X-API-Token access
#
# Cloudflare KV binding: PRIVATE_CONFIG (encrypted Hypixel API key + status metadata)
#
# Plain Worker vars (wrangler.jsonc):
# AUTO_LOG_ENABLED=true
# SKYCRYPT_PLAYER=justiwantdreams
# SKYCRYPT_PROFILE=Raspberry
# AUTO_LOG_INACTIVITY_HOURS=24
# AUTO_LOG_MIN_INTERVAL_HOURS=24
